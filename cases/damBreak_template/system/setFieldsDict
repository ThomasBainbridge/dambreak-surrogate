FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}

defaultFieldValues
(
    volScalarFieldValue alpha.water 0
);

regions
(
    boxToCell
    {
        box (0 0 -1) (0.146100000 0.292000000 1);

        fieldValues
        (
            volScalarFieldValue alpha.water 1
        );
    }
);

